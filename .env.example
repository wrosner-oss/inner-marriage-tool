# Copy to .env and fill in.

# Dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (MySQL) — also switch `provider = "mysql"` in prisma/schema.prisma:
# DATABASE_URL="mysql://user:pass@host:3306/inner_marriage"

PORT=3001

# Shared-password gate (Pangolin already fronts auth; this is extra). Blank = off.
APP_PASSWORD=
# Optional explicit cookie-signing secret; derived from APP_PASSWORD if blank.
AUTH_SECRET=

# Gmail draft creation (Google Workspace service account). See GMAIL_SETUP.md.
# GMAIL_SENDER=amelia@ameliaperkins.com
# GOOGLE_SERVICE_ACCOUNT_KEY=   # raw JSON, base64 of it, or a file path
# GMAIL_SUBJECT=Your Inner Marriage according to Shamanic Astrology
